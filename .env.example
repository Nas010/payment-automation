SPREADSHEET_ID=1I7N201rghJ77R2vEk6ZvqOD1kZB-dCZrDD5sD3aArjA
GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account"}'
PROMPTPAY_TYPE=phone
PROMPTPAY_IDENTIFIER=CONFIG_REQUIRED
RECIPIENT_NAME_EN=CONFIG_REQUIRED
RECIPIENT_NAME_TH=
BUSINESS_DISPLAY_NAME=CONFIG_REQUIRED
PRODUCTION_BASE_URL=CONFIG_REQUIRED
ADMIN_SECRET=CONFIG_REQUIRED
CRON_SECRET=CONFIG_REQUIRED
# Vercel calls /api/cron/generate daily at 02:05 UTC. It catches up pending due payments;
# do not keep the legacy Apps Script generateDuePaymentLinks trigger after rollout.
SLIP_STORAGE_FOLDER_ID=CONFIG_REQUIRED
SLIP_RETENTION_DAYS=30
OCR_ENABLED=true
# One base64-encoded 32-byte production key. Generate with: openssl rand -base64 32
SETTINGS_ENCRYPTION_KEY=CONFIG_REQUIRED
# Webhook is disabled unless this value is true (case-insensitive, surrounding whitespace ignored).
LINE_LINKING_ENABLED=false
# Outbound LINE due-payment messages and chat-slip payment intake are disabled by default.
# Stage them separately after linking succeeds: enable messaging first, then chat payments.
# The protected Settings page, not this file, owns line_due_message_template default/custom/preview/reset.
LINE_MESSAGING_ENABLED=false
LINE_CHAT_PAYMENTS_ENABLED=false
# Optional migration/development fallback only. Enter credentials in protected Settings, then remove these values.
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
