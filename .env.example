# Developer-owned bootstrap/key-safe workbook. Never use the target's operational workbook ID here.
SPREADSHEET_ID=CONFIG_REQUIRED
GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account"}'

# Developer infrastructure secrets.
ADMIN_SECRET=CONFIG_REQUIRED
CRON_SECRET=CONFIG_REQUIRED
# One base64-encoded 32-byte key. Generate with: openssl rand -base64 32
SETTINGS_ENCRYPTION_KEY=CONFIG_REQUIRED

# Google OAuth + Picker. Publish the OAuth consent app as Production before handoff.
GOOGLE_DRIVE_OAUTH_CLIENT_ID=CONFIG_REQUIRED
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=CONFIG_REQUIRED
GOOGLE_DRIVE_PICKER_API_KEY=CONFIG_REQUIRED
GOOGLE_DRIVE_PROJECT_NUMBER=CONFIG_REQUIRED

# Business, PromptPay, recipient, public URL, retention, OCR, LINE feature flags,
# LINE credentials, workbook, and slip folder are configured inside the dashboard.
